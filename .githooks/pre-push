#!/bin/sh
# Last local check before anything goes public: every outgoing commit must be
# authored+committed with the noreply address and carry a good signature.
set -e
NOREPLY="158637640+BrandonDoster@users.noreply.github.com"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list "$range"); do
    ae=$(git log -1 --format=%ae "$c"); ce=$(git log -1 --format=%ce "$c"); sig=$(git log -1 --format=%G? "$c")
    if [ "$ae" != "$NOREPLY" ] || [ "$ce" != "$NOREPLY" ]; then
      echo "PUSH BLOCKED: $c has author/committer email $ae / $ce" >&2; status=1
    fi
    if [ "$sig" != "G" ]; then
      echo "PUSH BLOCKED: $c signature status '$sig' (need G)" >&2; status=1
    fi
  done
done
exit $status
